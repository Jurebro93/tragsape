# Trag šape — varijable okruženja. Kopiraj u .env.local za lokalni rad.
# Prave vrijednosti nikad ne idu u repozitorij ni u razgovor.

# Javna adresa stranice (bez kose crte na kraju).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: Project Settings → API. Lokalno ih ispisuje `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Tajna za sažetke posjetitelja (dnevna svijeća, ograničenja). Bilo koji dug nasumičan niz.
HASH_SECRET=

# Stripe (testni ključevi dok se ne lansira). Bez njih je kupnja isključena.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mail obavijesti (Resend). Bez ključa se poruke samo zapisuju u dnevnik poslužitelja.
RESEND_API_KEY=
EMAIL_FROM="Trag šape <pozdrav@tragsape.hr>"

# Zaštita javnih obrazaca (Cloudflare Turnstile). Bez ključeva rade zamka i ograničenja učestalosti.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OIB (pravna osoba) ili matični broj (fizička osoba) trgovca. Ulazi u naziv datoteke cjenika
# za strojno čitanje na /cjenik.csv (Pravilnik o načinu objave cjenika proizvoda, NN 132/2026).
SELLER_TAX_ID=

# Zaglavlje s pravom adresom posjetitelja koje upisuje posrednik domaćina (npr. cf-connecting-ip).
# Prazno: uzima se prva adresa iz x-forwarded-for. Što stiže, vidi se u adminu pod „Stanje sustava".
CLIENT_IP_HEADER=

# Zakazani poslovi (podsjetnici, odgođeni pokloni): tajna koju šalje onaj tko zove /api/cron/*.
CRON_SECRET=

# AI pomoćnik za priču (Anthropic). Bez ključa je pomoćnik isključen.
ANTHROPIC_API_KEY=

# Samo lokalno: testni poštanski sandučić lokalnog Supabasea.
MAILPIT_URL=
